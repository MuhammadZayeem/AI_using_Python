my_details={
    "Name":"Zayeem",
    "Age": 19,
    "Course": "Python",
}
print(my_details)

#Accessing Values
print(my_details["Age"])
print(my_details.get("Course"))

#Changing Values in dictionary
my_details["Age"]=20                #update
my_details["City"]="Bahawalnagar"   #Add
my_details.pop("Course")            #Delete
print(my_details)

#Loop dictionary
for key,value in my_details.items():
    print(key,":",value)