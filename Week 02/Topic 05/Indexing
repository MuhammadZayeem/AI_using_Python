   'City':['Lahore','Islamabad','Karachi','Quetta'],
    'Grades':['A','C','B','D']
}
data ["salary"]=[2000,3000,4000,1000]

df=pd.DataFrame(data)
print("Original data : \n",df)

#Label Based Selection
subset_loc=df.loc[1:3,['Name','City']]
